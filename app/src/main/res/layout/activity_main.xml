<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:background="#EEEEEE"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:padding="16dp"
        android:text="0"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swDegrees"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:text="Trigonometría en grados (apagado = radianes)"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDisplay" />

    <Button
        android:id="@+id/btnSin"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="sin"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCos"
        app:layout_constraintTop_toBottomOf="@id/swDegrees" />

    <Button
        android:id="@+id/btnCos"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="cos"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btnSin"
        app:layout_constraintEnd_toStartOf="@id/btnTan"
        app:layout_constraintTop_toBottomOf="@id/swDegrees" />

    <Button
        android:id="@+id/btnTan"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="tan"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btnCos"
        app:layout_constraintEnd_toStartOf="@id/btnClear"
        app:layout_constraintTop_toBottomOf="@id/swDegrees" />

    <Button
        android:id="@+id/btnClear"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="C"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btnTan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/swDegrees" />

    <Button
        android:id="@+id/btn7"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="7"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn8"
        app:layout_constraintTop_toBottomOf="@id/btnSin" />

    <Button
        android:id="@+id/btn8"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="8"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btn7"
        app:layout_constraintEnd_toStartOf="@id/btn9"
        app:layout_constraintTop_toBottomOf="@id/btnCos" />

    <Button
        android:id="@+id/btn9"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="9"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btn8"
        app:layout_constraintEnd_toStartOf="@id/btnDiv"
        app:layout_constraintTop_toBottomOf="@id/btnTan" />

    <Button
        android:id="@+id/btnDiv"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="/"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btn9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnClear" />

    <Button
        android:id="@+id/btn4"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="4"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn5"
        app:layout_constraintTop_toBottomOf="@id/btn7" />

    <Button
        android:id="@+id/btn5"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="5"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btn4"
        app:layout_constraintEnd_toStartOf="@id/btn6"
        app:layout_constraintTop_toBottomOf="@id/btn8" />

    <Button
        android:id="@+id/btn6"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="6"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btn5"
        app:layout_constraintEnd_toStartOf="@id/btnMul"
        app:layout_constraintTop_toBottomOf="@id/btn9" />

    <Button
        android:id="@+id/btnMul"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="*"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btn6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnDiv" />

    <Button
        android:id="@+id/btn1"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="1"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn2"
        app:layout_constraintTop_toBottomOf="@id/btn4" />

    <Button
        android:id="@+id/btn2"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="2"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btn1"
        app:layout_constraintEnd_toStartOf="@id/btn3"
        app:layout_constraintTop_toBottomOf="@id/btn5" />

    <Button
        android:id="@+id/btn3"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="3"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btn2"
        app:layout_constraintEnd_toStartOf="@id/btnSub"
        app:layout_constraintTop_toBottomOf="@id/btn6" />

    <Button
        android:id="@+id/btnSub"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="-"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btn3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMul" />

    <Button
        android:id="@+id/btn0"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="0"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnDot"
        app:layout_constraintTop_toBottomOf="@id/btn1" />

    <Button
        android:id="@+id/btnDot"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="."
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btn0"
        app:layout_constraintEnd_toStartOf="@id/btnEq"
        app:layout_constraintTop_toBottomOf="@id/btn2" />

    <Button
        android:id="@+id/btnEq"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="="
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btnDot"
        app:layout_constraintEnd_toStartOf="@id/btnAdd"
        app:layout_constraintTop_toBottomOf="@id/btn3" />

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_margin="4dp"
        android:text="+"
        android:textAllCaps="false"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/btnEq"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSub" />

</androidx.constraintlayout.widget.ConstraintLayout>